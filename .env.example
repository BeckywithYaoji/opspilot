# Required: configure your OpenAI-compatible provider. Never commit .env.
LLM_API_KEY=
# Include provider API prefix, e.g. https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=

# Local dependencies. Compose overrides these with its internal service names.
REDIS_URL=redis://localhost:6379/0
# Blank uses data/qdrant and data/qdrant-incidents (local exclusive file locks).
QDRANT_URL=
SESSION_MEMORY_TTL_SECONDS=3600
SESSION_MEMORY_MAX_MESSAGES=10
# Pending approval TTL in Redis; in-memory fallback does not expire.
APPROVAL_TTL_SECONDS=1800
# Published API port; bound to localhost only.
OPSPILOT_PORT=8000
# Local structured trace output. Current tracer is always enabled.
TRACE_OUTPUT_PATH=data/traces/traces.jsonl
# Content capture toggle is not implemented: traces currently include tool arguments.
# password/token/secret/api_key/authorization keys are redacted.
# Langfuse adapter is a stub, currently disabled even if keys are supplied.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
